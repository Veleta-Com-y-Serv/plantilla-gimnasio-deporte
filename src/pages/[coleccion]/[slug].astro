---
// Ficha de un elemento con `detalle` (src/lib/paginas.ts, listas de src/data/fichas.ts): /clases/<slug>/.
// Diseño «gimnasio»: tema oscuro de la plantilla, hero con titular condensado en mayúsculas, foto con corte diagonal,
// etiqueta de intensidad con medidor, botones inclinados; cuerpo con el `detalle` y, al lado, la tabla de datos y una
// caja de prueba gratis con borde de acento; franja de fotos y otras clases en tarjetas planas con raya de acento.
import Base from '../../layouts/Base.astro';
import Imagen from '../../components/ui/Imagen.astro';
import Icono from '../../components/ui/Icono.astro';
import Titular from '../../components/ui/Titular.astro';
import { seccion, site, tel, whatsapp } from '../../data/site';
import { fichas, relacionadas, resumen } from '../../lib/paginas';
import type { Ficha } from '../../lib/paginas';
import { altGaleria, jsonLdFicha, jsonLdMigas, urlBase } from '../../lib/seo';

export function getStaticPaths() {
  return fichas().map((f) => ({ params: { coleccion: f.def.ruta, slug: f.slug }, props: { f } }));
}

interface Props { f: Ficha }
const { f } = Astro.props;
const base = urlBase(Astro.site);
const nombreSeccion = String(f.seccion.antetitulo || f.seccion.titulo || f.def.nombre).trim();
const migas = [
  { nombre: 'Inicio', ruta: '/' },
  { nombre: nombreSeccion, ruta: `/#${f.idSeccion}` },
  { nombre: f.titulo, ruta: f.url },
];
const c = site.contacto;
const cita = seccion('contacto') ? '/#contacto' : site.boton_cabecera?.url || '/#contacto';
const textoCita = site.boton_cabecera?.texto || 'Prueba gratis';
const wa = whatsapp(c.whatsapp, `Hola, quiero información sobre la clase de ${f.titulo}`);
const intensidad = f.datos.find((d) => d.clave === 'intensidad')?.valor ?? '';
const nivel = ({ suave: 1, baja: 1, media: 2, alta: 3 } as Record<string, number>)[intensidad.trim().toLowerCase()] ?? 0;
const datos = f.datos.filter((d) => d.clave !== 'precio');
const otras = relacionadas(f, 3);
const descripcion = resumen(f.texto || f.detalle[0] || '');
---

<Base titulo={f.titulo} descripcion={descripcion} imagen={f.imagen} ld={[jsonLdMigas(base, migas), jsonLdFicha(base, f)]}>
  <section class="ficha-cabeza">
    <div class="contenedor">
      <nav aria-label="Migas de pan" class="migas">
        <ol>
          {migas.map((m, i) => (
            <li>{i < migas.length - 1 ? <a href={m.ruta}>{m.nombre}</a> : <span aria-current="page">{m.nombre}</span>}</li>
          ))}
        </ol>
      </nav>
      <div class:list={['ficha-hero', { 'ficha-hero--sin-foto': !f.imagen }]}>
        <div class="ficha-hero-texto">
          <p class="antetitulo">{f.categoria || f.def.nombre}</p>
          <h1 class="titulo-seccion">{f.titulo}</h1>
          {f.texto && <p class="titular-texto">{f.texto}</p>}
          {(intensidad || f.precio) && (
            <p class="ficha-chips">
              {intensidad && (
                <span class="etiqueta">
                  {nivel > 0 && (
                    <span class="ficha-medidor" aria-hidden="true">
                      {[1, 2, 3].map((n) => <i class:list={{ lleno: n <= nivel }} />)}
                    </span>
                  )}
                  {intensidad}
                </span>
              )}
              {f.precio && <span class="ficha-precio">{f.precio}</span>}
            </p>
          )}
          <div class="ficha-botones">
            <a class="btn" href={cita}>{textoCita}</a>
            {wa && <a class="btn-sec" href={wa} target="_blank" rel="noopener"><Icono nombre="whatsapp" tam={18} /> WhatsApp</a>}
          </div>
        </div>
        {f.imagen ? (
          <div class="ficha-foto">
            <Imagen src={f.imagen} alt={f.titulo} ancho={1200} alto={900} prioridad class="h-full w-full object-cover" />
          </div>
        ) : (
          <div class="ficha-icono" aria-hidden="true"><Icono nombre={f.icono || 'pesa'} tam={96} /></div>
        )}
      </div>
    </div>
  </section>

  <section class="seccion banda-superficie">
    <div class="contenedor ficha-cuerpo">
      <article class="texto-largo ficha-detalle">
        {f.detalle.map((p) => <p>{p}</p>)}
      </article>
      <aside class="ficha-lado">
        {(datos.length > 0 || f.precio) && (
          <div class="ficha-datos">
            <h2 class="ficha-lado-titulo">Lo esencial</h2>
            <dl>
              {f.precio && <div><dt>Precio</dt><dd class="ficha-precio">{f.precio}</dd></div>}
              {datos.map((d) => <div><dt>{d.etiqueta}</dt><dd>{d.valor}</dd></div>)}
            </dl>
          </div>
        )}
        <div class="ficha-cita">
          <p class="ficha-cita-titulo">Ven a probarla</p>
          <p>La primera clase es gratis y sin compromiso. Reserva tu plaza y te esperamos en la sala.</p>
          <a class="btn" href={cita}>{textoCita}</a>
          {c.telefono && <a class="ficha-tel" href={tel(c.telefono)}><Icono nombre="telefono" tam={18} /> {c.telefono}</a>}
        </div>
      </aside>
    </div>
  </section>

  {f.imagenes.length > 0 && (
    <section class="seccion" aria-label={`Fotos de ${f.titulo}`}>
      <div class="contenedor">
        <ul class="ficha-galeria">
          {f.imagenes.map((src, i) => (
            <li><Imagen src={src} alt={`${f.titulo}: ${altGaleria(i).toLowerCase()}`} ancho={800} alto={600} class="h-full w-full object-cover" /></li>
          ))}
        </ul>
      </div>
    </section>
  )}

  {otras.length > 0 && (
    <section class="seccion banda-superficie">
      <div class="contenedor">
        <Titular antetitulo={nombreSeccion} titulo="Otras clases" />
        <ul class="ficha-otras">
          {otras.map((o) => (
            <li class="ficha-otra">
              <span class="ficha-otra-icono"><Icono nombre={o.icono || 'pesa'} tam={26} /></span>
              <h3><a href={o.url} class="ficha-otra-enlace">{o.titulo}</a></h3>
              {o.texto && <p>{o.texto}</p>}
              <p class="ficha-otra-pie">
                {o.precio && <span class="ficha-precio">{o.precio}</span>}
                <span class="ficha-otra-ver" aria-hidden="true">Ver <Icono nombre="flecha" tam={16} /></span>
              </p>
            </li>
          ))}
        </ul>
        <p class="mt-10"><a class="btn-sec" href={`/#${f.idSeccion}`}>Ver todas las clases</a></p>
      </div>
    </section>
  )}
</Base>

<style>
  .ficha-cabeza { padding-block: clamp(1.5rem, 3vw, 2.5rem) clamp(3rem, 6vw, 5rem); background: var(--negro); position: relative; overflow: hidden; }
  .ficha-cabeza::after { content: ""; position: absolute; right: -2rem; bottom: 0; width: 9rem; height: .9rem; background: var(--franjas); opacity: .8; transform: skewX(-30deg); }
  .migas ol { display: flex; flex-wrap: wrap; gap: .25rem .5rem; font-size: .9rem; font-weight: 650; }
  .migas li { display: inline-flex; align-items: center; gap: .5rem; min-width: 0; }
  .migas li + li::before { content: "/"; color: var(--c-acento); }
  .migas a { color: inherit; text-decoration: none; opacity: .8; min-height: 2.75rem; display: inline-flex; align-items: center; }
  .migas a:hover { text-decoration: underline; color: var(--c-acento); opacity: 1; }
  .migas [aria-current] { color: var(--c-acento); overflow-wrap: anywhere; }
  .ficha-hero { display: grid; gap: 2.5rem; margin-top: clamp(1rem, 3vw, 2.5rem); align-items: center; }
  .ficha-hero-texto .titulo-seccion { font-size: clamp(2.8rem, 10vw, 5.5rem); overflow-wrap: anywhere; }
  .ficha-chips { display: flex; flex-wrap: wrap; align-items: center; gap: .75rem 1.25rem; margin-top: 1.5rem; }
  .ficha-medidor { display: inline-flex; gap: 2px; }
  .ficha-medidor i { width: 5px; height: 12px; background: color-mix(in srgb, currentColor 30%, transparent); transform: skewX(-15deg); }
  .ficha-medidor i.lleno { background: var(--c-acento); }
  .ficha-precio { font-family: var(--fuente-titulos); font-stretch: condensed; font-weight: 800; font-size: 1.35rem; text-transform: uppercase; color: var(--c-acento); }
  .ficha-botones { display: flex; flex-wrap: wrap; gap: .75rem 1rem; margin-top: 2rem; }
  .ficha-botones a { display: inline-flex; align-items: center; justify-content: center; gap: .5rem; }
  .ficha-foto { aspect-ratio: 4 / 3; overflow: hidden; background: var(--superficie-2); clip-path: polygon(8% 0, 100% 0, 100% 100%, 0 100%); }
  .ficha-icono { display: grid; place-items: center; aspect-ratio: 4 / 3; background: var(--superficie); color: var(--c-acento); border-bottom: 3px solid var(--c-acento); }
  .ficha-cuerpo { display: grid; gap: 3rem; }
  .ficha-detalle { max-width: 44rem; font-size: 1.1rem; }
  .ficha-detalle p + p { margin-top: 1.2rem; }
  .ficha-detalle p:first-child { font-size: 1.25rem; }
  .ficha-lado { display: grid; gap: 1.5rem; align-content: start; }
  .ficha-lado-titulo { font-size: 1.6rem; margin-bottom: 1rem; color: var(--c-acento); }
  .ficha-datos { background: var(--c-fondo); border-left: 4px solid var(--c-acento); padding: 1.5rem; }
  .ficha-datos dl { display: grid; }
  .ficha-datos dl > div { display: flex; justify-content: space-between; gap: 1rem; padding: .8rem 0; border-top: 1px solid var(--linea); }
  .ficha-datos dt { font-weight: 700; opacity: .7; }
  .ficha-datos dd { text-align: right; font-weight: 650; min-width: 0; overflow-wrap: anywhere; }
  .ficha-cita { display: grid; gap: .9rem; background: var(--c-acento); color: var(--sobre-acento); padding: 1.75rem 1.5rem; clip-path: polygon(0 0, 100% 0, 100% calc(100% - 1.2rem), calc(100% - 1.2rem) 100%, 0 100%); }
  .ficha-cita-titulo { font-family: var(--fuente-titulos); font-stretch: condensed; text-transform: uppercase; font-size: 2rem; font-weight: 800; line-height: .95; }
  .ficha-cita .btn { display: inline-flex; align-items: center; justify-content: center; color: var(--c-acento); }
  .ficha-cita .btn::before { background: var(--sobre-acento); }
  .ficha-tel { display: inline-flex; align-items: center; gap: .5rem; min-height: 2.75rem; font-weight: 800; color: inherit; text-decoration: none; }
  .ficha-galeria { display: grid; gap: 1rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 20rem), 1fr)); }
  .ficha-galeria li { aspect-ratio: 4 / 3; overflow: hidden; }
  .ficha-otras { display: grid; gap: 1.25rem; grid-template-columns: repeat(auto-fill, minmax(min(100%, 18rem), 1fr)); }
  .ficha-otra { position: relative; display: flex; flex-direction: column; gap: .7rem; padding: 1.5rem; background: var(--c-fondo); border-bottom: 3px solid transparent; transition: border-color .2s ease; }
  .ficha-otra:hover { border-bottom-color: var(--c-acento); }
  .ficha-otra-icono { color: var(--c-acento); }
  .ficha-otra h3 { font-size: 1.9rem; }
  .ficha-otra-enlace { text-decoration: none; color: inherit; }
  .ficha-otra-enlace::after { content: ""; position: absolute; inset: 0; }
  .ficha-otra-enlace:focus-visible { outline: none; }
  .ficha-otra:has(.ficha-otra-enlace:focus-visible) { outline: 2px solid var(--c-acento); outline-offset: 2px; }
  .ficha-otra p { opacity: .8; }
  .ficha-otra-pie { display: flex; align-items: center; justify-content: space-between; gap: 1rem; margin-top: auto; padding-top: .5rem; opacity: 1 !important; }
  .ficha-otra-ver { display: inline-flex; align-items: center; gap: .3rem; font-weight: 800; color: var(--c-acento); text-transform: uppercase; }
  @media (min-width: 1024px) {
    .ficha-hero { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 4rem; }
    .ficha-cuerpo { grid-template-columns: minmax(0, 1.7fr) minmax(0, 1fr); gap: 5rem; align-items: start; }
    .ficha-lado { position: sticky; top: 6.5rem; }
  }
</style>
