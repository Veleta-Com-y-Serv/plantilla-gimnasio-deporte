---
// Apartado de texto genérico: antetítulo, título, párrafos, imagen opcional (con franjas de acento), lista y botón.
// Lo usan los apartados nuevos que pide el cliente (site.yaml: `tipo: texto`).
import { seccion, parrafos } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Imagen from '../ui/Imagen.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <div class:list={['grid items-center gap-12', s.imagen ? 'md:grid-cols-2 md:gap-16' : 'max-w-3xl']}>
        {s.imagen && (
          <div class="relative">
            <div class="absolute -bottom-3 -left-3 h-1/2 w-1/2 [background:var(--franjas)]" aria-hidden="true" />
            <Imagen src={s.imagen} alt="" ancho={1000} alto={750} class="relative aspect-[4/3] w-full object-cover" />
          </div>
        )}
        <div>
          {s.antetitulo && <p class="antetitulo">{s.antetitulo}</p>}
          {s.titulo && <h2 class="titulo-seccion">{s.titulo}</h2>}
          <div class="mt-6 space-y-4 opacity-85">
            {parrafos(s.texto).map((p) => <p>{p}</p>)}
          </div>
          {s.items.length > 0 && (
            <ul class="mt-8 space-y-4">
              {s.items.map((it) => (
                <li class="flex gap-4">
                  <Icono nombre={it.icono} class="acento mt-1 shrink-0" tam={22} />
                  <div>
                    <p class="font-display text-xl font-bold uppercase [font-stretch:condensed]">{it.titulo}</p>
                    {it.texto && <p class="text-sm opacity-75">{it.texto}</p>}
                  </div>
                </li>
              ))}
            </ul>
          )}
          {s.cta?.url && <p class="mt-9 pl-1.5"><a class="btn" href={s.cta.url}>{s.cta.texto}</a></p>}
        </div>
      </div>
    </Seccion>
  )
}
