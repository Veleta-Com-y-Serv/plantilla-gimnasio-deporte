---
// Entrenadores: `personas: [{nombre, cargo, foto, texto}]` con retrato 3:4 en escala de grises que se colorea al pasar.
// Sin fotos de caras generadas: por defecto, la silueta /placeholders/persona.svg.
import { seccion } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Imagen from '../ui/Imagen.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
---

{
  s && (
    <Seccion id={Astro.props.id} class="banda-superficie">
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {s.personas.length > 0 && (
        <ul class="grid grid-cols-2 gap-x-4 gap-y-8 md:grid-cols-3 lg:grid-cols-4">
          {s.personas.map((p) => (
            <li class="entrenador group">
              <div class="entrenador-foto">
                <Imagen src={p.foto || '/placeholders/persona.svg'} alt={p.nombre} ancho={600} alto={800} class="aspect-[3/4] w-full object-cover grayscale transition duration-300 group-hover:grayscale-0" />
              </div>
              <h3 class="mt-4 text-[1.6rem] md:text-[1.9rem]">{p.nombre}</h3>
              {p.cargo && <p class="entrenador-cargo">{p.cargo}</p>}
              {p.texto && <p class="mt-2 text-sm opacity-75 md:text-base">{p.texto}</p>}
            </li>
          ))}
        </ul>
      )}
    </Seccion>
  )
}

<style>
  .entrenador-foto { position: relative; overflow: hidden; }
  .entrenador-foto::after { content: ""; position: absolute; left: 0; bottom: 0; width: 100%; height: .5rem; background: var(--c-acento); transform: scaleX(.25); transform-origin: left; transition: transform .3s ease; }
  .entrenador:hover .entrenador-foto::after { transform: scaleX(1); }
  .entrenador-cargo { margin-top: .2rem; font-family: var(--fuente-titulos); font-stretch: condensed; font-weight: 700; text-transform: uppercase; letter-spacing: .08em; font-size: .9rem; color: var(--c-acento); }
</style>
