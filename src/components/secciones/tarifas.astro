---
// Tarifas: `planes: [{nombre, precio, periodo, incluye (cadena con «;»), destacado (true/false), cta_texto}]`
// en bloques (3 por fila); el destacado lleva resplandor del color de acento. Precio vacío = no se pinta.
// El botón de cada plan lleva a `cta.url` de la sección (o a #contacto). Sin planes: titular, texto, `nota` y `cta`.
import { seccion, puntos } from '../../data/site';
import Seccion from '../ui/Seccion.astro';
import Titular from '../ui/Titular.astro';
import Icono from '../ui/Icono.astro';
interface Props { id: string }
const s = seccion(Astro.props.id);
const planes = s?.planes ?? [];
const destino = s?.cta?.url || '/#contacto';
const columnas = Math.min(Math.max(planes.length, 1), 3);
---

{
  s && (
    <Seccion id={Astro.props.id}>
      <Titular antetitulo={s.antetitulo} titulo={s.titulo} texto={s.texto} />
      {planes.length > 0 && (
        <ul class="planes" style={`--cols:${columnas}`}>
          {planes.map((p) => (
            <li class:list={['plan', { 'plan--destacado': p.destacado === true }]}>
              <h3 class="text-[2.2rem]">{p.nombre}</h3>
              {p.precio && (
                <p class="plan-precio">
                  <span class="plan-cifra">{p.precio}</span>
                  {p.periodo && <span class="plan-periodo">{p.periodo}</span>}
                </p>
              )}
              {!p.precio && p.periodo && <p class="plan-periodo mt-3">{p.periodo}</p>}
              {puntos(p.incluye).length > 0 && (
                <ul class="mt-6 grid gap-2.5">
                  {puntos(p.incluye).map((x) => (
                    <li class="flex gap-2.5">
                      <Icono nombre="check" tam={20} class="acento mt-0.5 shrink-0" />
                      <span>{x}</span>
                    </li>
                  ))}
                </ul>
              )}
              {p.cta_texto && (
                <p class="mt-auto pt-8 pl-1.5">
                  <a class:list={[p.destacado === true ? 'btn' : 'btn-sec', 'w-[calc(100%-.75rem)]']} href={destino}>{p.cta_texto}</a>
                </p>
              )}
            </li>
          ))}
        </ul>
      )}
      {s.nota && <p class="mt-8 text-sm opacity-70">{s.nota}</p>}
      {planes.length === 0 && s.cta && (
        <p class="mt-2 pl-1.5">
          <a class="btn" href={s.cta.url}>{s.cta.texto}</a>
        </p>
      )}
    </Seccion>
  )
}

<style>
  .planes { display: grid; gap: 1.5rem; align-items: stretch; }
  @media (min-width: 900px) { .planes { grid-template-columns: repeat(var(--cols), minmax(0, 1fr)); max-width: calc(var(--cols) * 24rem); } }
  .plan { display: flex; flex-direction: column; padding: 2rem 1.5rem; background: var(--superficie); border: 1px solid var(--linea); position: relative; }
  .plan--destacado { border: 2px solid var(--c-acento); box-shadow: 0 0 0 1px color-mix(in srgb, var(--c-acento) 30%, transparent), 0 0 48px -6px color-mix(in srgb, var(--c-acento) 55%, transparent); background: color-mix(in srgb, var(--c-acento) 7%, var(--superficie)); }
  .plan--destacado::before { content: ""; position: absolute; top: -2px; left: 1.5rem; width: 4.5rem; height: .55rem; background: var(--franjas); }
  @media (min-width: 900px) { .plan { padding: 2.5rem 2rem; } .plan--destacado { transform: translateY(-.75rem); } }
  .plan-precio { display: flex; align-items: baseline; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
  .plan-cifra { font-family: var(--fuente-titulos); font-stretch: condensed; font-weight: 800; font-size: clamp(3rem, 12vw, 4.25rem); line-height: .9; letter-spacing: -0.03em; }
  .plan--destacado .plan-cifra { color: var(--c-acento); }
  .plan-periodo { font-family: var(--fuente-titulos); font-stretch: condensed; text-transform: uppercase; letter-spacing: .08em; opacity: .7; }
</style>
